# Netlify headers — security + cache policy (production).
# HTML: revalidate every visit (fresh content, still edge-cached).
/*.html
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate
/
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate
# Assets: immutable for a year (filenames are content-stable).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=86400, must-revalidate
# app-ads.txt: short cache so ad-network crawlers always see fresh sellers.
/app-ads.txt
  Cache-Control: public, max-age=3600
